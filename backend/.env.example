# ==============================================================
# AI Assessment Extraction - Environment Variables Template
# ==============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Groq API (Required for Grading & Semantic Matching) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# --- Server Settings ---
HOST=0.0.0.0
PORT=8000

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- File Handling ---
SESSION_STORAGE_PATH=./sessions
MAX_FILE_SIZE_MB=50

# --- Session Management ---
SESSION_EXPIRY_MINUTES=60
CLEANUP_INTERVAL_MINUTES=10

# --- Tesseract OCR ---
# Leave blank to auto-detect. Set if tesseract is in a non-standard location.
# macOS (brew): /usr/local/bin/tesseract  or  /opt/homebrew/bin/tesseract
TESSERACT_PATH=

# --- TrOCR Model ---
TROCR_MODEL=microsoft/trocr-base-handwritten
USE_GPU=false

# --- Logging ---
LOG_LEVEL=INFO
